# Copy this file to .env and fill in real values. Never commit .env.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Public address of the site (used for canonical URLs, sitemap and Open Graph tags)
SITE_URL=http://127.0.0.1:5000

# Set to 1 only on your own computer
FLASK_DEBUG=1

# Set to true when the site is served over HTTPS
SESSION_COOKIE_SECURE=false

# Shows dashed "To confirm" boxes for business details still to be verified.
# Set to false before launch.
SHOW_PLACEHOLDERS=true

# Optional business details (shown only when filled in)
BUSINESS_EMAIL=
BUSINESS_STREET=
BUSINESS_POSTAL_CODE=
# Leave blank to hide the Instagram link
INSTAGRAM_URL=https://www.instagram.com/sparkssolarenergy/

# Where enquiries are stored (default: instance/enquiries.sqlite3)
DATABASE_PATH=

# ---- Optional email notifications for new enquiries ----
# Example for Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true,
# MAIL_USERNAME=your Gmail address, MAIL_PASSWORD=a Google "App password".
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
